# Normalize text files
* text=auto

# HDL / constraints / scripts
*.v     text eol=lf
*.sv    text eol=lf
*.vh    text eol=lf
*.xdc   text eol=lf
*.tcl   text eol=lf
*.md    text eol=lf
*.gitignore text eol=lf

# Vivado project XML, if temporarily tracked
*.xpr   text eol=lf

# Binary generated files
*.dcp   binary
*.bit   binary
*.bin   binary
*.mcs   binary
*.ltx   binary
*.wdb   binary
*.pdf   binary